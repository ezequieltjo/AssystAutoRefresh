{
  "manifest_version": 3,
  "name": "Help Desk Auto-Refresh",
  "version": "1.0.0",
  "description": "Atualiza a lista de chamados do Help Desk clicando no botão Atualizar em intervalos definidos.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://portaldeservicostjpb.lanlink.com.br/assystweb/application.do*"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Help Desk Auto-Refresh"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
